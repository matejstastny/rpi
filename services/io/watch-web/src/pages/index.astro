---
import Base from "../layouts/Base.astro";
---

<Base title="watchlist">
    <div class="app">
        <header class="topbar">
            <div class="brand">
                <svg class="brand-glyph" viewBox="0 0 16 16" aria-hidden="true">
                    <circle
                        cx="8"
                        cy="8"
                        r="6.6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"></circle>
                    <path d="M1.4 8a6.6 6.6 0 0 0 13.2 0z" fill="currentColor"></path>
                </svg>
                <span class="brand-name">watchlist</span>
                <span class="brand-host">· io</span>
            </div>

            <nav class="kinds" id="kinds" aria-label="Library"></nav>

            <div class="topbar-right">
                <label class="search">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        aria-hidden="true"
                    >
                        <circle cx="6.8" cy="6.8" r="4.4"></circle>
                        <path d="M10.2 10.2 14 14" stroke-linecap="round"></path>
                    </svg>
                    <input id="filter" type="text" placeholder="Filter titles" autocomplete="off" />
                </label>

                <button class="btn btn-primary" id="add-open">
                    <svg
                        width="13"
                        height="13"
                        viewBox="0 0 14 14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <path d="M7 2v10M2 7h10"></path>
                    </svg>
                    Add
                </button>

                <button
                    class="btn btn-icon"
                    id="settings-open"
                    title="Settings"
                    aria-label="Settings"
                >
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                    >
                        <circle cx="8" cy="8" r="2.3"></circle>
                        <path
                            d="M8 1.4v1.6M8 13v1.6M3.3 3.3l1.1 1.1M11.6 11.6l1.1 1.1M1.4 8h1.6M13 8h1.6M3.3 12.7l1.1-1.1M11.6 4.4l1.1-1.1"
                            stroke-linecap="round"></path>
                    </svg>
                </button>
            </div>
        </header>

        <div class="body">
            <aside class="sidebar">
                <p class="sidebar-label">Views</p>
                <nav class="views" id="views" aria-label="Views"></nav>
                <div class="sidebar-foot">
                    <div class="legend" id="legend"></div>
                </div>
            </aside>

            <main class="content" id="content" aria-live="polite"></main>
        </div>
    </div>

    <dialog id="add">
        <div class="sheet">
            <div class="sheet-head">
                <h2 id="add-title">Add to the watchlist</h2>
                <span class="spacer"></span>
                <button class="btn btn-ghost btn-icon" data-close="add" aria-label="Close">✕</button
                >
            </div>
            <div class="sheet-body" id="add-body"></div>
            <div class="sheet-foot" id="add-foot"></div>
        </div>
    </dialog>

    <dialog id="detail" class="to-right">
        <div class="drawer">
            <div class="sheet-head">
                <h2>Entry</h2>
                <span class="spacer"></span>
                <button class="btn btn-ghost btn-icon" data-close="detail" aria-label="Close">
                    ✕
                </button>
            </div>
            <div class="sheet-body" id="detail-body"></div>
            <div class="sheet-foot" id="detail-foot"></div>
        </div>
    </dialog>

    <dialog id="settings">
        <div class="sheet sheet-wide">
            <div class="sheet-head">
                <h2>Settings</h2>
                <span class="spacer"></span>
                <button class="btn btn-ghost btn-icon" data-close="settings" aria-label="Close">
                    ✕
                </button>
            </div>
            <div class="sheet-body" id="settings-body"></div>
            <div class="sheet-foot" id="settings-foot"></div>
        </div>
    </dialog>

    <div class="toast-stack" id="toasts"></div>

    <script>
        import "../scripts/app";
    </script>
</Base>
