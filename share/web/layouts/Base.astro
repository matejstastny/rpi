---
import Shell from "@rpi/ui/Shell.astro";
import maple400 from "@rpi/ui/fonts/maple-400.woff2?url";
import "../styles/app.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<Shell title={title} preload={maple400}>
    <main class="shell">
        <header class="top">
            <span class="mark">
                <span class="glyph">◒</span> share <span class="host">· io</span>
            </span>
        </header>
        <slot />
        <footer>quickshare on io · tailnet only · oldest rolls off past the cap</footer>
    </main>
</Shell>
